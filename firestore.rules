rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    function isSignedIn() { return request.auth != null; }
    
    match /users/{userId}/saves/{saveId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /saves/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /{leaderboardCollection}/{userId} {
      allow read: if leaderboardCollection.matches('^leaderboards_.*');
      allow write: if leaderboardCollection.matches('^leaderboards_.*') && isSignedIn() && request.auth.uid == userId;
    }
  }
}
